<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hami_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hami_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:contentDescription="@string/hami_widget_label"
        android:scaleType="fitCenter"
        android:src="@drawable/hami_widget_pet" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hami_widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#3A2E4A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hami_widget_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:textColor="#5A4E6A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hami_widget_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#4AA6D8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hami_widget_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2F86D1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hami_widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#E2414B"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
