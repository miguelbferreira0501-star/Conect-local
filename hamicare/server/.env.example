# Copie para .env. Nunca envie o .env para o repositório.
NODE_ENV=development
PORT=3002
# Papel da API (sem privilégios de dono; as políticas RLS valem para tudo)
DATABASE_URL=postgres://hamicare_app:hamicare_app@localhost:5432/hamicare
# Papel dono do esquema (só migrações)
DATABASE_OWNER_URL=postgres://hamicare:hamicare@localhost:5432/hamicare
DB_APP_ROLE=hamicare_app
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:5173,http://localhost:3002
SESSION_DAYS=60
# E-mails que viram administradores ao iniciar (separados por vírgula)
ADMIN_EMAILS=
# Pasta do app compilado (servido pelo mesmo processo em produção)
WEB_DIST=../web/dist
# Notificações push: sem chaves, são geradas e guardadas no banco no primeiro uso
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@hamicare.app
# E-mail de "Esqueci minha senha" pelo Resend (https://resend.com). Sem chave, o e-mail aparece no terminal.
# RESEND_API_KEY=re_...
# MAIL_FROM=HamiCare <nao-responda@seudominio.com.br>
# Endereço público usado nos links dos e-mails (no Render, vem sozinho)
# APP_URL=http://localhost:5173
