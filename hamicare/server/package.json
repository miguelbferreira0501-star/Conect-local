{
  "name": "@hamicare/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do HamiCare: contas, backup, amigos, feed moderado, admin e lembretes.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "reset": "tsx --env-file-if-exists=.env src/cli.ts reset",
    "deploy": "tsx --env-file-if-exists=.env src/cli.ts deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "^3.6.4",
    "smtp-server": "^3.21.3",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.9"
  }
}
