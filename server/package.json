{
  "name": "@conecta/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=../.env src/db/cli.ts migrate",
    "locations": "tsx --env-file-if-exists=../.env src/db/cli.ts locations",
    "seed": "tsx --env-file-if-exists=../.env src/db/cli.ts seed",
    "deploy": "tsx --env-file-if-exists=../.env src/db/cli.ts deploy",
    "reset": "tsx --env-file-if-exists=../.env src/db/cli.ts reset",
    "preview:data": "tsx --env-file-if-exists=../.env scripts/export-preview.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@conecta/shared": "0.1.0",
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
