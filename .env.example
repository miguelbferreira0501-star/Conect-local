# Copie para .env e ajuste. Nunca envie o .env para o repositório.
NODE_ENV=development
PORT=3001
# Papel da APLICAÇÃO (sem privilégios de dono; as políticas RLS se aplicam)
DATABASE_URL=postgres://conecta_app:conecta_app@localhost:5432/conecta
# Papel DONO do esquema (somente migrações e seed)
DATABASE_OWNER_URL=postgres://conecta:conecta@localhost:5432/conecta
DB_APP_ROLE=conecta_app
# Alternativa a DATABASE_URL: com DB_APP_PASSWORD, o db:deploy cria o papel e a URL é montada a partir de DATABASE_OWNER_URL
# DB_APP_PASSWORD=
# true = mostra dados de exemplo identificados na interface
DEMO_MODE=true
# true em produção (HTTPS)
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:5173,http://localhost:3001
SESSION_DAYS=30
# App Android (Play Store) — usado em /.well-known/assetlinks.json
# ANDROID_PACKAGE_NAME=br.com.conectalocal.app
# ANDROID_CERT_SHA256=AA:BB:...
